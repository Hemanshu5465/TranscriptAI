# ─────────────────────────────────────────────────────────────
# TranscriptAI — environment configuration
# Local dev: copy to backend/.env and fill in values.
# Production (Vercel): set these in Project → Settings → Environment Variables.
# NEVER commit a real .env.
# ─────────────────────────────────────────────────────────────

# --- Core ---
# Local dev default is SQLite (zero setup):
DATABASE_URL=sqlite:///./.data/transcriptai.db
# Production — a hosted Postgres. Neon gives you a URL like:
#   postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# Prefix it with the driver so SQLAlchemy uses psycopg 3:
#   DATABASE_URL=postgresql+psycopg://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Secret used to sign JWT access tokens. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# CORS allow-origin. Only matters when the API is on a different origin than the
# frontend. On Vercel (same origin) you can leave the default.
FRONTEND_ORIGIN=http://localhost:5173

# Run `alembic upgrade head` automatically on first request (Postgres only).
# Leave true for serverless; harmless locally (SQLite is skipped).
AUTO_MIGRATE=true

# --- Background jobs ---
# thread = in-process background worker (local / always-on hosts). DEFAULT.
# inline = run the transcription synchronously inside the request. USE THIS ON VERCEL.
# redis  = enqueue to an RQ worker (needs REDIS_URL + a running `rq worker`).
JOB_QUEUE=thread
REDIS_URL=redis://localhost:6379/0
JOB_TIMEOUT_SECONDS=1800
MAX_JOBS_PER_USER_PER_MONTH=50

# --- Transcription provider ---
# supadata | youtube_captions | faster_whisper | deepgram
# Leave as youtube_captions — if SUPADATA_API_KEY is set the app auto-prefers Supadata.
TRANSCRIPTION_PROVIDER=youtube_captions
TRANSCRIPTION_FALLBACK=true

# Supadata (https://supadata.ai) — hosted transcript API that fetches captions
# server-side, so it works from datacenter IPs (Vercel) where the direct
# youtube-transcript-api gets blocked. Free tier: 100/month, no card.
# This is the recommended fix for "YouTube declined the request from this network".
SUPADATA_API_KEY=
# Audio download + local Whisper. Needs requirements-optional.txt + ffmpeg.
# Cannot run on Vercel serverless. Off by default.
ENABLE_AUDIO_FALLBACK=false
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- YouTube proxy (makes hosted transcription reliable) ---
# YouTube blocks caption requests from datacenter IPs (Vercel/Render/etc). A
# residential proxy fixes this. Webshare's "Residential" plan is the cheapest path
# (youtube-transcript-api has built-in support). Leave blank for local use.
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
# Or a generic HTTP proxy instead of Webshare:
HTTP_PROXY_URL=
HTTPS_PROXY_URL=

# --- AI formatting ---
# rule_based (default, no key) | claude
AI_PROVIDER=rule_based
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# --- Video metadata ---
# Optional. Without it, public oEmbed is used (title + thumbnail + author only).
YOUTUBE_API_KEY=

# --- Optional cloud STT ---
DEEPGRAM_API_KEY=

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_CREATE=10/minute
